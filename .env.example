# ⚠️ CRITICAL: Never commit actual .env file to Git (it's in .gitignore)
# Copy this to .env and fill in your actual values

# SERVER CONFIGURATION
PORT=5000
DATABASE_URL="file:./dev.db"

# JWT AUTHENTICATION (⚠️ REQUIRED FOR PRODUCTION - DO NOT USE DEFAULT)
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-jwt-secret-key"

# FIREBASE CONFIGURATION
# Get these from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# CLOUDINARY CONFIGURATION (for image uploads)
# Get these from Cloudinary Dashboard > Settings
VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"
VITE_CLOUDINARY_API_KEY="your-api-key"
VITE_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"

# GOOGLE GEMINI AI CONFIGURATION (Primary: Gemini 3.6 Flash / 3.5 Flash-Lite / 3.7 Flash)
# Get API key from: https://aistudio.google.com/
VITE_GEMINI_API_KEY="your-gemini-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# GROQ AI CONFIGURATION (Secondary Failover: openai/gpt-oss-120b, qwen/qwen3.8-27b)
# Get API key from: https://console.groq.com/
VITE_GROQ_API_KEY="your-groq-api-key"
GROQ_API_KEY="your-groq-api-key"

# MISTRAL AI CONFIGURATION (Tertiary Failover: mistral-small-latest, ministral-8b-latest)
# Get API key from: https://console.mistral.ai/
VITE_MISTRAL_API_KEY="your-mistral-api-key"
MISTRAL_API_KEY="your-mistral-api-key"

# OPENROUTER AI CONFIGURATION (Quaternary Failover: nvidia/nemotron-3.5-lightning:free, minimax/minimax-m3:free)
# Get API key from: https://openrouter.ai/
VITE_OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

