# ==============================================================================
# Enhance Portfolio - Environment Configuration Example
# Copy this file to .env and provide your actual production secrets.
# NEVER commit the actual .env file to public version control.
# ==============================================================================

# Node Environment & Server Port
NODE_ENV="development"
PORT=5000

# CORS Whitelist (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://yourdomain.com"

# Local SQLite Database URL (Prisma)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (Cryptographic token signature)
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-cryptographically-secure-random-32-byte-secret"

# Appwrite Cloud Configuration (Auth, Storage & Databases)
# Retrieved from Appwrite Console > Project Settings
VITE_APPWRITE_ENDPOINT="https://sgp.cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="your-appwrite-project-id"
VITE_APPWRITE_BUCKET_ID="portfolio"
VITE_APPWRITE_DATABASE_ID="portfolio"
VITE_APPWRITE_COLLECTION_PORTFOLIO="portfolio"
VITE_APPWRITE_COLLECTION_MESSAGES="messages"

# Appwrite Secret Server API Key (for server-side administrative operations)
APPWRITE_API_KEY="your-appwrite-server-secret-api-key"

# AI Provider API Keys (Server-Side Proxy)
ANYMODEL_API_KEY="your-anymodel-api-key"
UNOROUTER_API_KEY="your-unorouter-api-key"

# In-App Email Dispatch (Gmail SMTP with Google App Password)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER="your-account@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-google-app-password"
OUTLOOK_USER="agustino.julian@outlook.ph"
OUTLOOK_SENDER_NAME="Julian Agustino"
